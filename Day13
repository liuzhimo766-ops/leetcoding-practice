你可以假设每种输入只会对应一个答案，并且你不能使用两次相同的元素。

你可以按任意顺序返回答案。
class Solution:
    def twoSum(self, nums: list[int], target: int) -> list[int]:
        map={}
        for idx,i in enumerate(nums):
            res=target-i
            if res in map:
                return [map[res],idx]
            map[i]=idx


            
